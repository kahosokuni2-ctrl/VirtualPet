void setup(){
  size(400,400);
  noStroke();
  fill(#6F5F33);
  //body
  ellipse(240,200,200,100);
  //frontleg
  ellipse(190,200,90,150);
  rect(170,250,30,100);
  //backleg
  ellipse(310,210,90,130);
  rect(320,240,30,110);
  //neck
  ellipse(160,200,90,80);
  ellipse(140,200,70,60);
  //Head
  triangle(30,220,120,150,120,220);
  rect(70,170,60,20);
  rect(30,190,60,40);
  //horn
  fill(#B79F51);
  arc(120,160,130,130,PI,7*PI/4);
  rect(20,150,50,10);
  triangle(20,100,10,160,30,160);
  triangle(60,50,80,120,100,100);
  triangle(90,40,110,120,130,100);
  triangle(120,40,140,120,170,113);
  //eyes
  fill(#030303);
  ellipse(100,190,15,15);
}
